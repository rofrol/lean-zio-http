+// INVESTIGATION ONLY (item srx6tz), not part of the server: one loop's events with
+// wall and thread-CPU clocks, written to $LSRV_TRACE when the loop ends.
+const TraceEv = extern struct { kind: u32, id: u32, n: u64, w0: i64, w1: i64, c0: i64, c1: i64, v0: i64, v1: i64, i0: i64, i1: i64 };
+var trace_v0: i64 = 0;
+var trace_i0: i64 = 0;
+fn csw(v: *i64, i: *i64) void {
+    var ru: std.c.rusage = undefined;
+    _ = std.c.getrusage(std.c.rusage.SELF, &ru);
+    v.* = ru.nvcsw;
+    i.* = ru.nivcsw;
+}
+var trace_buf: []TraceEv = &.{};
+var trace_len: usize = 0;
+fn clockNs(id: std.c.clockid_t) i64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(id, &ts);
+    return @as(i64, ts.sec) * 1_000_000_000 + ts.nsec;
+}
+pub export fn lsrv_trace_start(w0: *i64, c0: *i64) void {
+    if (trace_buf.len == 0) return;
+    csw(&trace_v0, &trace_i0);
+    w0.* = clockNs(.REALTIME);
+    c0.* = clockNs(.THREAD_CPUTIME_ID);
+}
+pub export fn lsrv_trace_end(kind: u32, id: u32, n: u64, w0: i64, c0: i64) void {
+    if (trace_buf.len == 0 or trace_len == trace_buf.len) return;
+    const w1 = clockNs(.REALTIME);
+    const c1 = clockNs(.THREAD_CPUTIME_ID);
+    var v1: i64 = 0;
+    var ic1: i64 = 0;
+    csw(&v1, &ic1);
+    trace_buf[trace_len] = .{ .kind = kind, .id = id, .n = n, .w0 = w0, .c0 = c0, .w1 = w1, .c1 = c1, .v0 = trace_v0, .v1 = v1, .i0 = trace_i0, .i1 = ic1 };
+    trace_len += 1;
+}
+fn traceInit() void {
+    if (std.c.getenv("LSRV_TRACE") == null) return;
+    trace_buf = alloc.alloc(TraceEv, 4 << 20) catch @panic("trace alloc");
+    @memset(std.mem.sliceAsBytes(trace_buf), 0);
+}
+fn traceDump() void {
+    const path = std.c.getenv("LSRV_TRACE") orelse return;
+    const fd = std.c.open(path, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true }, @as(c_uint, 0o644));
+    if (fd < 0) @panic("trace open");
+    const bytes = std.mem.sliceAsBytes(trace_buf[0..trace_len]);
+    var off: usize = 0;
+    while (off < bytes.len) {
+        const r = std.c.write(fd, bytes[off..].ptr, bytes.len - off);
+        if (r <= 0) @panic("trace write");
+        off += @intCast(r);
+    }
+    _ = std.c.close(fd);
+}
